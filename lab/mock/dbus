#!/bin/bash
# skipd dbus 模拟：键值存在 /tmp/lab/dbus.db（每行 key=value）
DB=/tmp/lab/dbus.db
touch $DB
case "$1" in
get) grep -m1 "^$2=" $DB | cut -d= -f2- ;;
set)
	k=${2%%=*}; v=${2#*=}
	grep -v "^$k=" $DB >$DB.tmp || true
	printf '%s=%s\n' "$k" "$v" >>$DB.tmp
	mv $DB.tmp $DB ;;
remove) grep -v "^$2=" $DB >$DB.tmp || true; mv $DB.tmp $DB ;;
list) grep "^$2" $DB || true ;;
export)
	# 真机 skipd 的格式：export k="v"，值原样输出、不转义（插件脚本已不再 eval 它）
	grep "^$2" $DB | while IFS= read -r l; do printf 'export %s="%s"\n' "${l%%=*}" "${l#*=}"; done ;;
esac
